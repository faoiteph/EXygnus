{
    "name": "exygnus/exygnus",
    "type": "project",
    "description": "Bagisto Laravel E-Commerce",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.3 <8.5",
        "ext-calendar": "*",
        "ext-curl": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-tokenizer": "*",
        "astrotomic/laravel-translatable": "^11.16",
        "barryvdh/laravel-dompdf": "^2.0.0|^3.0",
        "diglactic/laravel-breadcrumbs": "^10.0",
        "elasticsearch/elasticsearch": "^8.10",
        "enshrined/svg-sanitize": "^0.22.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "intervention/image": "^2.4|^3.0",
        "kalnoy/nestedset": "^6.0",
        "khaled.alshamaa/ar-php": "^6.0.0",
        "konekt/concord": "^1.16",
        "laravel/ai": "^0.2.2",
        "laravel/cashier": "^16.0",
        "laravel/framework": "^12.0",
        "laravel/octane": "^2.3",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.0",
        "laravel/tinker": "^2.10",
        "laravel/ui": "^4.0",
        "maatwebsite/excel": "^3.1.46",
        "mpdf/mpdf": "^8.2",
        "nesbot/carbon": "^3.0",
        "paypal/paypal-server-sdk": "^2.0",
        "pragmarx/google2fa": "^8.0",
        "predis/predis": "^2.2",
        "prettus/l5-repository": "^2.6",
        "pusher/pusher-php-server": "^7.0",
        "razorpay/razorpay": "^2.9",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "spatie/laravel-responsecache": "^7.4",
        "spatie/laravel-sitemap": "^7.3",
        "stevebauman/purify": "^6.3",
        "stripe/stripe-php": "^17.3",
        "web-token/jwt-framework": "^4.1"
    },
    "require-dev": {
        "bagisto/laravel-datafaker": "2.3.*",
        "barryvdh/laravel-debugbar": "^3.8",
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.1",
        "laravel/pint": "^1.19",
        "laravel/sail": "^1.66",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "DeFaoite\\Admin\\": "packages/DeFaoite/Admin/src",
            "DeFaoite\\Attribute\\": "packages/DeFaoite/Attribute/src",
            "DeFaoite\\BookingProduct\\": "packages/DeFaoite/BookingProduct/src",
            "DeFaoite\\CMS\\": "packages/DeFaoite/CMS/src",
            "DeFaoite\\CartRule\\": "packages/DeFaoite/CartRule/src",
            "DeFaoite\\CatalogRule\\": "packages/DeFaoite/CatalogRule/src",
            "DeFaoite\\Category\\": "packages/DeFaoite/Category/src",
            "DeFaoite\\Checkout\\": "packages/DeFaoite/Checkout/src",
            "DeFaoite\\Core\\": "packages/DeFaoite/Core/src",
            "DeFaoite\\Customer\\": "packages/DeFaoite/Customer/src",
            "DeFaoite\\DataGrid\\": "packages/DeFaoite/DataGrid/src",
            "DeFaoite\\DataTransfer\\": "packages/DeFaoite/DataTransfer/src",
            "DeFaoite\\DebugBar\\": "packages/DeFaoite/DebugBar/src",
            "DeFaoite\\EUWithdrawal\\": "packages/DeFaoite/EUWithdrawal/src",
            "DeFaoite\\FPC\\": "packages/DeFaoite/FPC/src",
            "DeFaoite\\GDPR\\": "packages/DeFaoite/GDPR/src",
            "DeFaoite\\ImageCache\\": "packages/DeFaoite/ImageCache/src",
            "DeFaoite\\Installer\\": "packages/DeFaoite/Installer/src",
            "DeFaoite\\Inventory\\": "packages/DeFaoite/Inventory/src",
            "DeFaoite\\MagicAI\\": "packages/DeFaoite/MagicAI/src",
            "DeFaoite\\Marketing\\": "packages/DeFaoite/Marketing/src",
            "DeFaoite\\Notification\\": "packages/DeFaoite/Notification/src",
            "DeFaoite\\PayGlocal\\": "packages/DeFaoite/PayGlocal/src",
            "DeFaoite\\PayU\\": "packages/DeFaoite/PayU/src",
            "DeFaoite\\Payment\\": "packages/DeFaoite/Payment/src",
            "DeFaoite\\Paypal\\": "packages/DeFaoite/Paypal/src",
            "DeFaoite\\PhonePe\\": "packages/DeFaoite/PhonePe/src",
            "DeFaoite\\Product\\": "packages/DeFaoite/Product/src",
            "DeFaoite\\RMA\\": "packages/DeFaoite/RMA/src",
            "DeFaoite\\Razorpay\\": "packages/DeFaoite/Razorpay/src",
            "DeFaoite\\Rule\\": "packages/DeFaoite/Rule/src",
            "DeFaoite\\Sales\\": "packages/DeFaoite/Sales/src",
            "DeFaoite\\Shipping\\": "packages/DeFaoite/Shipping/src",
            "DeFaoite\\Shop\\": "packages/DeFaoite/Shop/src",
            "DeFaoite\\Sitemap\\": "packages/DeFaoite/Sitemap/src",
            "DeFaoite\\SocialLogin\\": "packages/DeFaoite/SocialLogin/src",
            "DeFaoite\\SocialShare\\": "packages/DeFaoite/SocialShare/src",
            "DeFaoite\\Stripe\\": "packages/DeFaoite/Stripe/src",
            "DeFaoite\\Tax\\": "packages/DeFaoite/Tax/src",
            "DeFaoite\\Theme\\": "packages/DeFaoite/Theme/src",
            "DeFaoite\\User\\": "packages/DeFaoite/User/src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "DeFaoite\\Admin\\Tests\\": "packages/DeFaoite/Admin/tests",
            "DeFaoite\\Core\\Tests\\": "packages/DeFaoite/Core/tests",
            "DeFaoite\\Customer\\Tests\\": "packages/DeFaoite/Customer/tests",
            "DeFaoite\\DataGrid\\Tests\\": "packages/DeFaoite/DataGrid/tests",
            "DeFaoite\\EUWithdrawal\\Tests\\": "packages/DeFaoite/EUWithdrawal/tests",
            "DeFaoite\\Installer\\Tests\\": "packages/DeFaoite/Installer/tests",
            "DeFaoite\\PayGlocal\\Tests\\": "packages/DeFaoite/PayGlocal/tests",
            "DeFaoite\\Payment\\Tests\\": "packages/DeFaoite/Payment/tests",
            "DeFaoite\\PayU\\Tests\\": "packages/DeFaoite/PayU/tests",
            "DeFaoite\\Razorpay\\Tests\\": "packages/DeFaoite/Razorpay/tests",
            "DeFaoite\\Shop\\Tests\\": "packages/DeFaoite/Shop/tests",
            "DeFaoite\\Stripe\\Tests\\": "packages/DeFaoite/Stripe/tests"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-create-project-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "intervention/image",
                "laravel/socialite"
            ]
        }
    },
    "repositories": [{
        "type": "path",
        "url": "packages/*/*",
        "options": {
            "symlink": true
        }
    }],
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/faoiteph/EXygnus/issues",
        "source": "https://github.com/faoiteph/EXygnus",
        "docs": "https://docs.exygnus.com"
    }
}
